# ---------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------
# Multitenant
# ---------------------------------------------------------------------
# Dominio raiz de la plataforma. Cada vivero vive en <slug>.<ROOT_DOMAIN>
# y tambien puede tener su dominio propio (tabla tenant_domains).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Hosts extra que NO son de un vivero (landing, app, admin central).
NEXT_PUBLIC_PLATFORM_HOSTS=

# Solo para desarrollo: si entras por http://localhost:3000 sin subdominio,
# se usa este vivero. En produccion dejalo vacio.
NEXT_PUBLIC_DEV_TENANT_SLUG=
